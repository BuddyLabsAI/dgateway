# Required: admin bearer token; choose a long random value.
ADMIN_TOKEN=
# Required for storing provider keys; keep stable to decrypt them.
GATEWAY_SECRET=
# Optional: key for the two seeded OpenAI providers. Each reads this variable through its own key setting.
# `openai` calls OpenAI's Decisions API. `openai-chat` (disabled) asks chat models and marks the answers synthetic.
OPENAI_API_KEY=
# Optional: key for the two seeded OpenRouter providers. Each reads this variable through its own key setting.
# `openrouter` calls OpenRouter's decisions API. `openrouter-chat` (disabled) asks chat models and marks the answers synthetic.
OPENROUTER_API_KEY=
# Optional: key for the seeded `typesafe` provider (disabled), whose model is Jev.
TYPESAFE_API_KEY=
# Optional: listen address and port (default 0.0.0.0 and 8790). HOST and PORT also work when these are unset; a HOST
# that is not an IP address, localhost, 0.0.0.0 or :: is ignored. In Docker, publish the container port instead.
# DGATEWAY_HOST=0.0.0.0
# DGATEWAY_PORT=8790
